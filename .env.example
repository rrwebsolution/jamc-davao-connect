# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API (or "API Keys").

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Optional. Where links in emails (sign-up, invitations, password reset) point.
# On Vercel the production domain is used automatically; set this only to
# override it, e.g. for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://jamc-davao-connect.vercel.app

# The publishable key (older projects call it the "anon" key). Safe for the
# browser: every request made with it is limited by row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (older projects call it "service_role"). SERVER ONLY. It
# bypasses row level security; never expose it or prefix it with NEXT_PUBLIC_.
# Used only to create, deactivate and delete logins from Administration -> Users.
SUPABASE_SECRET_KEY=

# Only for `npm run db:migrate`. Dashboard -> Connect -> Session pooler, with your
# database password in place of [YOUR-PASSWORD]. SERVER ONLY.
SUPABASE_DB_URL=
